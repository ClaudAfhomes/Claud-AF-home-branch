{
  "name": "afhomes-digital-experience",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package:source": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none src/lib/cmsAudit.test.ts src/lib/cmsLocal.test.ts && playwright test",
    "test:online": "node scripts/smoke-online.mjs",
    "deploy:check": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "motion": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "sweetalert2": "11.26.25",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
